# ============================================================
# Proyecto HV — Configuración de Entorno de Producción (VPS)
# ============================================================
# Instrucciones:
# 1. Copie este archivo a .env en el servidor:
#    cp .env.production.example .env
# 2. Reemplace todos los valores 'CAMBIAR_EN_PRODUCCION' con secretos seguros.
#    - Clave JWT: openssl rand -hex 64
#    - Claves DB y Redis: openssl rand -base64 32
#    - Clave Fernet para Backups: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 3. Restrinja permisos del archivo: chmod 600 .env
# 4. NUNCA suba el archivo .env a Git.
# ============================================================

# ---- Aplicación ----
APP_NAME="Plataforma de Gestión de Hojas de Vida"
APP_ENV=production
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# ---- API ----
API_V1_PREFIX=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ---- Dominio y URLs ----
DOMAIN_NAME=tu-dominio.gov.co
FRONTEND_URL=https://tu-dominio.gov.co
CORS_ALLOWED_ORIGINS=https://tu-dominio.gov.co

# ---- Seguridad y Autenticación JWT ----
# Generar con: openssl rand -hex 64
SECRET_KEY=CAMBIAR_EN_PRODUCCION_GENERAR_CON_OPENSSL_RAND_HEX_64
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Parámetros Argon2id (Recomendación OWASP para producción)
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4
MAX_FAILED_LOGIN_ATTEMPTS=5

# ---- Base de Datos PostgreSQL 16 (Red Interna Docker) ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=proyecto_hv
POSTGRES_USER=hv_app
# Generar con: openssl rand -base64 24
POSTGRES_PASSWORD=CAMBIAR_EN_PRODUCCION_PASSWORD_POSTGRESQL_SEGURO

# ---- Caché y Colas Redis 7 (Red Interna Docker) ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# Generar con: openssl rand -base64 24
REDIS_PASSWORD=CAMBIAR_EN_PRODUCCION_PASSWORD_REDIS_SEGURO

# ---- Almacenamiento Seguro de Documentos ----
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/app/data/documents
MAX_UPLOAD_SIZE_MB=25
ALLOWED_MIME_TYPES=application/pdf

# ---- Motor OCR y Document AI ----
OCR_PROVIDER=mock                     # mock | google_dai | azure_di
OCR_CONFIDENCE_HIGH_THRESHOLD=0.90
OCR_CONFIDENCE_MEDIUM_THRESHOLD=0.70

# Google Document AI (opcional si OCR_PROVIDER=google_dai)
GOOGLE_PROJECT_ID=
GOOGLE_PROCESSOR_ID=
GOOGLE_LOCATION=us
GOOGLE_SERVICE_ACCOUNT_JSON=

# Azure Document Intelligence (opcional si OCR_PROVIDER=azure_di)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# ---- Cola de Procesamiento Asíncrono (ARQ) ----
WORKER_CONCURRENCY=4
MAX_JOB_RETRIES=3

# ---- Copias de Seguridad Cifradas (DLP - Fernet AES-128) ----
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BACKUP_ENCRYPTION_KEY=CAMBIAR_EN_PRODUCCION_CLAVE_FERNET_BASE64
BACKUP_STORAGE_PATH=/app/data/backups
BACKUP_RETENTION_DAYS_LOCAL=7
BACKUP_RETENTION_DAYS_REMOTE=30
BACKUP_RCLONE_REMOTE=

# ---- Control de Tasa (Rate Limiting) ----
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=60
RATE_LIMIT_UPLOADS_PER_MINUTE=20
RATE_LIMIT_REPORTS_PER_MINUTE=15

# ---- Gunicorn Worker Configuration ----
WEB_CONCURRENCY=4
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
