# ============================================================
# Environment Configuration Example
# Copy to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ---- Application ----
APP_NAME="Gestión de Hojas de Vida"
APP_ENV=development          # development | staging | production
DEBUG=true
LOG_LEVEL=INFO

# ---- API ----
API_V1_PREFIX=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ---- Security ----
# Generate with: openssl rand -hex 64
SECRET_KEY=change-me-generate-with-openssl-rand-hex-64
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Argon2id settings (OWASP recommended defaults)
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# Max failed login attempts before lockout
MAX_FAILED_LOGIN_ATTEMPTS=5

# ---- Database ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=proyecto_hv
POSTGRES_USER=hv_app
POSTGRES_PASSWORD=change-me-strong-password
# Full connection string (overrides individual params if set)
# DATABASE_URL=postgresql+asyncpg://hv_app:password@localhost:5432/proyecto_hv

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_URL=redis://localhost:6379/0

# ---- File Storage ----
STORAGE_BACKEND=local            # local | minio | s3
STORAGE_LOCAL_PATH=./data/documents
MAX_UPLOAD_SIZE_MB=50
ALLOWED_MIME_TYPES=application/pdf

# MinIO / S3 (only needed when STORAGE_BACKEND != local)
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=proyecto-hv-documents
MINIO_SECURE=false

# AWS S3 (only needed when STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=

# ---- OCR / Document AI ----
OCR_PROVIDER=mock               # mock | google_dai | azure_di
OCR_CONFIDENCE_HIGH_THRESHOLD=0.90
OCR_CONFIDENCE_MEDIUM_THRESHOLD=0.70

# Google Document AI
GOOGLE_PROJECT_ID=
GOOGLE_PROCESSOR_ID=
GOOGLE_LOCATION=us
# Path to service account JSON (or use GOOGLE_APPLICATION_CREDENTIALS env)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Azure Document Intelligence
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# ---- Workers (ARQ) ----
WORKER_CONCURRENCY=4
MAX_JOB_RETRIES=3

# ---- CORS ----
# Comma-separated allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Backup ----
BACKUP_ENCRYPTION_KEY=change-me-backup-key
BACKUP_RETENTION_DAYS_LOCAL=7
BACKUP_RETENTION_DAYS_REMOTE=30
# rclone remote name (configure with: rclone config)
BACKUP_RCLONE_REMOTE=

# ---- Rate Limiting ----
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=60
